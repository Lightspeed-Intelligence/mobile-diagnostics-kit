internal object MobileDiagnosticsDoKit {
  private const val OPEN_EVENT = "mobile-diagnostics-kit.open"
  private const val OFFICIAL_NETWORK_KIT = "dokit_sdk_performance_ck_network"
  private const val CLEANUP_ATTEMPTS = 20
  private var lifecycleRestoreInstalled = false

  fun kits(): LinkedHashMap<String, List<AbstractKit>> = linkedMapOf(
    "Application Tools" to listOf(
      DestinationKit("network"),
      DestinationKit("storage"),
      DestinationKit("ota"),
    ),
  )

  fun scheduleNetworkKitCleanup() {
    cleanupNetworkKit(0)
  }

  fun installLifecycleRestore(application: Application) {
    if (lifecycleRestoreInstalled) return
    lifecycleRestoreInstalled = true
    application.registerActivityLifecycleCallbacks(object : Application.ActivityLifecycleCallbacks {
      override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) = Unit
      override fun onActivityStarted(activity: Activity) = Unit
      override fun onActivityResumed(activity: Activity) {
        DoKit.show()
      }
      override fun onActivityPaused(activity: Activity) = Unit
      override fun onActivityStopped(activity: Activity) = Unit
      override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) = Unit
      override fun onActivityDestroyed(activity: Activity) = Unit
    })
  }

  private fun cleanupNetworkKit(attempt: Int) {
    var removed = false
    DoKitManager.GLOBAL_KITS.values.forEach { kits ->
      if (kits.removeAll { item -> item.kit?.innerKitId() == OFFICIAL_NETWORK_KIT }) {
        removed = true
      }
    }
    DoKitManager.GLOBAL_SYSTEM_KITS.values.forEach { kits ->
      if (kits.removeAll { item -> item.kit?.innerKitId() == OFFICIAL_NETWORK_KIT }) {
        removed = true
      }
    }
    if (!removed && attempt < CLEANUP_ATTEMPTS) {
      android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
        { cleanupNetworkKit(attempt + 1) },
        100L,
      )
    }
  }

  private class DestinationKit(
    private val destination: String,
  ) : AbstractKit() {
    override val name: Int
      get() = when (destination) {
        "network" -> R.string.mobile_diagnostics_network
        "ota" -> R.string.mobile_diagnostics_expo_update
        else -> R.string.mobile_diagnostics_local_state
      }

    override val icon: Int
      get() = when (destination) {
        "network" -> android.R.drawable.ic_menu_search
        "ota" -> android.R.drawable.ic_popup_sync
        else -> android.R.drawable.ic_menu_edit
      }

    override fun onAppInit(context: Context?) {
      // The DoKit system kit is still useful as the capture engine, but its
      // old Activity must not remain visible beside our inspector.
      if (destination == "network") {
        scheduleNetworkKitCleanup()
      }
    }

    override fun onClickWithReturn(activity: Activity): Boolean {
      if (destination == "network") {
        cleanupNetworkKit(0)
        DoKit.hideToolPanel()
        startUniversalActivity(
          MobileDiagnosticsNetworkFragment::class.java,
          activity,
          null,
          true,
        )
        return true
      }

      val reactApplication = activity.application as? com.facebook.react.ReactApplication
      val reactContext = reactApplication?.reactHost?.currentReactContext
        ?: reactApplication?.reactNativeHost?.reactInstanceManager?.currentReactContext
      if (reactContext == null) {
        Toast.makeText(
          activity,
          R.string.mobile_diagnostics_runtime_unavailable,
          Toast.LENGTH_SHORT,
        ).show()
        return false
      }

      val payload = com.facebook.react.bridge.Arguments.createMap().apply {
        putString("destination", destination)
      }
      reactContext
        .getJSModule(com.facebook.react.modules.core.DeviceEventManagerModule.RCTDeviceEventEmitter::class.java)
        .emit(OPEN_EVENT, payload)
      DoKit.hideToolPanel()
      return true
    }
  }
}

private enum class MDKNetworkFilter(val label: String) {
  ALL("All"),
  FETCH("Fetch"),
  IMAGE("Image"),
  MEDIA("Media"),
  OTHER("Other"),
  ERRORS("Errors"),
}

private const val NETWORK_PAGE_SIZE = 100
private const val NETWORK_REFRESH_INTERVAL_MS = 500L

internal class MobileDiagnosticsNetworkFragment : BaseFragment() {
  private val mainHandler = Handler(Looper.getMainLooper())
  private lateinit var root: LinearLayout
  private lateinit var content: LinearLayout
  private var query = ""
  private var filter = MDKNetworkFilter.ALL
  private var selected: NetworkRecord? = null
  private var searchInput: EditText? = null
  private var visibleLimit = NETWORK_PAGE_SIZE
  private val listRefreshScheduled = AtomicBoolean(false)
  private val listRefreshRunnable = Runnable {
    listRefreshScheduled.set(false)
    if (isAdded && isResumed && selected == null) renderList()
  }

  private val networkListener = object : OnNetworkInfoUpdateListener {
    override fun onNetworkInfoUpdate(record: NetworkRecord?, isNew: Boolean) {
      if (listRefreshScheduled.compareAndSet(false, true)) {
        mainHandler.postDelayed(listRefreshRunnable, NETWORK_REFRESH_INTERVAL_MS)
      }
    }
  }

  override fun onRequestLayout(): Int = 0

  override fun onCreateView(
    inflater: LayoutInflater,
    container: ViewGroup?,
    savedInstanceState: Bundle?,
  ): View {
    root = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setBackgroundColor(Color.rgb(248, 250, 252))
    }
    ViewCompat.setOnApplyWindowInsetsListener(root) { view, insets ->
      val systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
      view.setPadding(systemBars.left, systemBars.top, systemBars.right, systemBars.bottom)
      insets
    }
    renderList()
    return root
  }

  override fun onResume() {
    super.onResume()
    NetworkManager.get().setOnNetworkInfoUpdateListener(networkListener)
    if (selected == null) renderList()
  }

  override fun onPause() {
    NetworkManager.get().setOnNetworkInfoUpdateListener(null)
    mainHandler.removeCallbacks(listRefreshRunnable)
    listRefreshScheduled.set(false)
    super.onPause()
  }

  override fun onDestroyView() {
    mainHandler.removeCallbacks(listRefreshRunnable)
    listRefreshScheduled.set(false)
    DoKit.show()
    super.onDestroyView()
  }

  override fun onBackPressed(): Boolean {
    if (selected != null) {
      selected = null
      renderList()
      return true
    }
    closeInspector()
    return true
  }

  private fun closeInspector() {
    DoKit.show()
    finish()
  }

  private fun renderList() {
    if (!::root.isInitialized) return
    selected = null
    root.removeAllViews()
    root.addView(header("Network", false) { closeInspector() })

    val records = records().asReversed()
    val visible = records.filter { record ->
      val matchesFilter = when (filter) {
        MDKNetworkFilter.ALL -> true
        MDKNetworkFilter.ERRORS -> isError(record)
        else -> resourceType(record) == filter
      }
      val needle = query.trim().lowercase(Locale.ROOT)
      matchesFilter && (needle.isEmpty() || searchableText(record).contains(needle))
    }
    val page = visible.take(visibleLimit)

    val toolbar = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(16), dp(10), dp(16), dp(4))
    }
    searchInput = EditText(requireContext()).apply {
      hint = "Search URL or method"
      inputType = InputType.TYPE_CLASS_TEXT
      setSingleLine(true)
      textSize = 15f
      setPadding(dp(14), 0, dp(14), 0)
      background = rounded(Color.WHITE, Color.rgb(203, 213, 225), dp(10))
      imeOptions = android.view.inputmethod.EditorInfo.IME_ACTION_SEARCH
      setText(query)
      setSelection(text.length)
      setOnEditorActionListener { _, _, _ ->
        query = text.toString()
        visibleLimit = NETWORK_PAGE_SIZE
        renderList()
        true
      }
    }
    toolbar.addView(searchInput, LinearLayout.LayoutParams(-1, dp(46)))

    val filterScroll = HorizontalScrollView(requireContext()).apply {
      isHorizontalScrollBarEnabled = false
      overScrollMode = View.OVER_SCROLL_NEVER
    }
    val chips = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      setPadding(0, dp(10), 0, dp(4))
    }
    MDKNetworkFilter.values().forEach { option ->
      val chip = TextView(requireContext()).apply {
        text = option.label
        textSize = 13f
        gravity = Gravity.CENTER
        setTypeface(null, Typeface.BOLD)
        setPadding(dp(14), 0, dp(14), 0)
        setTextColor(if (option == filter) Color.WHITE else Color.rgb(51, 65, 85))
        background = rounded(
          if (option == filter) Color.rgb(21, 128, 61) else Color.WHITE,
          if (option == filter) Color.rgb(21, 128, 61) else Color.rgb(203, 213, 225),
          dp(18),
        )
        setOnClickListener {
          filter = option
          visibleLimit = NETWORK_PAGE_SIZE
          renderList()
        }
        contentDescription = "Filter ${option.label}"
      }
      chips.addView(chip, LinearLayout.LayoutParams(-2, dp(36)).apply {
        marginEnd = dp(8)
      })
    }
    filterScroll.addView(chips)
    toolbar.addView(filterScroll, LinearLayout.LayoutParams(-1, dp(48)))
    content = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(16), dp(8), dp(16), dp(24))
    }
    toolbar.addView(text(
      "Showing ${page.size} of ${visible.size} matching · ${records.size} total",
      13f,
      Color.rgb(100, 116, 139),
    ))
    root.addView(toolbar)

    val scroll = ScrollView(requireContext()).apply {
      isFillViewport = true
      addView(content)
    }
    root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))

    if (visible.isEmpty()) {
      content.addView(text("No captured requests", 16f, Color.rgb(71, 85, 105)).apply {
        gravity = Gravity.CENTER
        setPadding(0, dp(60), 0, 0)
      })
    } else {
      page.forEach { record -> content.addView(requestCard(record)) }
      if (page.size < visible.size) {
        content.addView(text("Load older", 14f, Color.rgb(21, 128, 61), true).apply {
          gravity = Gravity.CENTER
          isClickable = true
          isFocusable = true
          background = rounded(Color.WHITE, Color.rgb(21, 128, 61), dp(10))
          setOnClickListener {
            visibleLimit += NETWORK_PAGE_SIZE
            renderList()
          }
          contentDescription = "Load older network requests"
          layoutParams = LinearLayout.LayoutParams(-1, dp(44)).apply {
            topMargin = dp(4)
          }
        })
      }
    }
  }

  private fun renderDetail(record: NetworkRecord) {
    selected = record
    root.removeAllViews()
    root.addView(header("Request details", true) {
      selected = null
      renderList()
    })
    val scroll = ScrollView(requireContext())
    val detail = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(16), dp(16), dp(16), dp(28))
    }
    val curl = curlCommand(record)
    val copy = text("Copy cURL", 14f, Color.WHITE).apply {
      gravity = Gravity.CENTER
      setTypeface(null, Typeface.BOLD)
      background = rounded(Color.rgb(21, 128, 61), Color.rgb(21, 128, 61), dp(10))
      setOnClickListener {
        val clipboard = requireContext().getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
        clipboard.setPrimaryClip(ClipData.newPlainText("cURL", curl))
        Toast.makeText(requireContext(), "cURL copied", Toast.LENGTH_SHORT).show()
      }
    }
    detail.addView(copy, LinearLayout.LayoutParams(-1, dp(44)).apply { bottomMargin = dp(14) })
    detail.addView(section("General", listOf(
      "URL" to requestUrl(record),
      "Method" to (record.mRequest?.method ?: "HTTP").uppercase(Locale.ROOT),
      "Status" to responseStatus(record),
      "Type" to resourceType(record).label,
      "Transfer" to "↑ ${record.requestLength} B  ·  ↓ ${record.responseLength} B",
    )))
    detail.addView(section("Request Headers", listOf("Headers" to (record.mRequest?.headers ?: "No headers"))))
    detail.addView(section("Payload", listOf("Body" to (record.mRequest?.postData ?: "No body"))))
    detail.addView(section("Response Headers", listOf("Headers" to (record.mResponse?.headers ?: "No headers"))))
    detail.addView(section("Response Body", listOf("Body" to (record.mResponseBody ?: "No body"))))
    scroll.addView(detail)
    root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))
  }

  private fun header(title: String, detail: Boolean, onBack: () -> Unit): View {
    val bar = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(8), 0, dp(16), 0)
      setBackgroundColor(Color.WHITE)
    }
    val back = text("‹  Back", 16f, Color.rgb(21, 128, 61)).apply {
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(8), 0, dp(14), 0)
      isClickable = true
      isFocusable = true
      setOnClickListener { onBack() }
      contentDescription = if (detail) "Back to network" else "Close network"
    }
    bar.addView(back, LinearLayout.LayoutParams(dp(96), dp(56)))
    bar.addView(text(title, 19f, Color.rgb(15, 23, 42), true).apply {
      gravity = Gravity.CENTER_VERTICAL
    }, LinearLayout.LayoutParams(0, dp(56), 1f))
    return bar
  }

  private fun requestCard(record: NetworkRecord): View {
    val card = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(14), dp(12), dp(14), dp(12))
      background = rounded(Color.WHITE, Color.rgb(226, 232, 240), dp(12))
      isClickable = true
      isFocusable = true
      setOnClickListener { renderDetail(record) }
    }
    val firstLine = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
    }
    firstLine.addView(text((record.mRequest?.method ?: "HTTP").uppercase(Locale.ROOT), 12f, Color.rgb(21, 128, 61), true).apply {
      gravity = Gravity.CENTER
      background = rounded(Color.rgb(220, 252, 231), Color.rgb(187, 247, 208), dp(6))
      setPadding(dp(8), 0, dp(8), 0)
    }, LinearLayout.LayoutParams(-2, dp(28)))
    firstLine.addView(text(responseStatus(record), 13f, if (isError(record)) Color.rgb(185, 28, 28) else Color.rgb(21, 128, 61), true).apply {
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(10), 0, 0, 0)
    }, LinearLayout.LayoutParams(-2, dp(28)))
    card.addView(firstLine)
    card.addView(text(requestUrl(record), 15f, Color.rgb(15, 23, 42), true).apply {
      maxLines = 2
      ellipsize = android.text.TextUtils.TruncateAt.END
      setPadding(0, dp(9), 0, dp(3))
    })
    card.addView(text("${resourceType(record).label}  ·  ↑ ${record.requestLength} B  ·  ↓ ${record.responseLength} B", 12f, Color.rgb(100, 116, 139)))
    return card.apply {
      layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(10) }
    }
  }

  private fun section(title: String, rows: List<Pair<String, String>>): View {
    val block = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      background = rounded(Color.WHITE, Color.rgb(226, 232, 240), dp(10))
      setPadding(dp(14), dp(12), dp(14), dp(12))
    }
    block.addView(text(title, 15f, Color.rgb(21, 128, 61), true))
    rows.forEach { (label, value) ->
      block.addView(text(label, 12f, Color.rgb(100, 116, 139), true).apply { setPadding(0, dp(12), 0, dp(3)) })
      block.addView(text(value, 14f, Color.rgb(15, 23, 42)).apply {
        setTextIsSelectable(true)
        setPadding(0, 0, 0, dp(2))
      })
    }
    return block.apply {
      layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(12) }
    }
  }

  private fun records(): List<NetworkRecord> {
    val all = NetworkManager.get().records
    return synchronized(all) { all.toList() }
  }

  private fun requestUrl(record: NetworkRecord): String = record.mRequest?.url ?: "Unknown URL"

  private fun responseStatus(record: NetworkRecord): String {
    val status = record.mResponse?.status ?: 0
    return if (status > 0) status.toString() else "Pending"
  }

  private fun searchableText(record: NetworkRecord): String = listOf(
    requestUrl(record),
    record.mRequest?.method.orEmpty(),
    record.mResponse?.mimeType.orEmpty(),
  ).joinToString(" ").lowercase(Locale.ROOT)

  private fun isError(record: NetworkRecord): Boolean {
    val status = record.mResponse?.status ?: 0
    return status <= 0 || status >= 400
  }

  private fun resourceType(record: NetworkRecord): MDKNetworkFilter {
    val mime = record.mResponse?.mimeType.orEmpty().lowercase(Locale.ROOT)
    val url = requestUrl(record).lowercase(Locale.ROOT)
    if (mime.startsWith("image/") || url.substringBefore('?').matches(Regex(".*\\.(png|jpe?g|gif|webp|svg)$"))) {
      return MDKNetworkFilter.IMAGE
    }
    if (mime.startsWith("video/") || mime.startsWith("audio/") || url.substringBefore('?').matches(Regex(".*\\.(mp4|mov|mp3|m4a|wav)$"))) {
      return MDKNetworkFilter.MEDIA
    }
    if (mime.contains("json") || mime.contains("text") || mime.contains("xml") ||
      (record.mRequest?.method?.uppercase(Locale.ROOT) in setOf("GET", "POST", "PUT", "PATCH", "DELETE"))) {
      return MDKNetworkFilter.FETCH
    }
    return MDKNetworkFilter.OTHER
  }

  private fun curlCommand(record: NetworkRecord): String {
    val request = record.mRequest
    val method = (request?.method ?: "GET").uppercase(Locale.ROOT)
    return buildString {
      append("curl --location --request ").append(shellQuote(method)).append(" ")
      append(shellQuote(request?.url ?: ""))
      request?.headers.orEmpty().split(Regex("\\r?\\n")).forEach { line ->
        val separator = line.indexOf(':')
        if (separator > 0) {
          append(" \\\\n  -H ").append(shellQuote(line.trim()))
        }
      }
      if (!request?.postData.isNullOrEmpty()) {
        append(" \\\\n  --data-raw ").append(shellQuote(request?.postData.orEmpty()))
      }
    }
  }

  private fun shellQuote(value: String): String = "'${value.replace("'", "'\\\\''")}'"

  private fun rounded(fill: Int, stroke: Int, radius: Int): GradientDrawable = GradientDrawable().apply {
    setColor(fill)
    setStroke(dp(1), stroke)
    cornerRadius = radius.toFloat()
  }

  private fun text(value: String, size: Float, color: Int, bold: Boolean = false): TextView = TextView(requireContext()).apply {
    text = value
    textSize = size
    setTextColor(color)
    if (bold) setTypeface(null, Typeface.BOLD)
  }

  private fun dp(value: Int): Int = (value * resources.displayMetrics.density).toInt()
}
