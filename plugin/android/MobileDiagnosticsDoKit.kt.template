package __PACKAGE__

import android.app.Activity
import android.app.Application
import android.content.Context
import android.os.Bundle
import android.view.Gravity
import android.view.LayoutInflater
import android.view.View
import android.widget.FrameLayout
import com.didichuxing.doraemonkit.DoKit
import com.didichuxing.doraemonkit.kit.AbstractKit
import com.didichuxing.doraemonkit.kit.core.AbsDoKitView
import com.didichuxing.doraemonkit.kit.core.DoKitViewLayoutParams
import com.didichuxing.doraemonkit.kit.core.DoKitManager
import java.util.LinkedHashMap

internal object MobileDiagnosticsDoKit {
  private const val OFFICIAL_NETWORK_KIT = "dokit_sdk_performance_ck_network"
  private const val CLEANUP_ATTEMPTS = 20
  private var lifecycleRestoreInstalled = false
  private var launcherInitialized = false
  private var inspectorVisible = false
  private var currentActivity: Activity? = null

  fun kits(): LinkedHashMap<String, List<AbstractKit>> = linkedMapOf(
    "Application Tools" to listOf(
      DestinationKit("network"),
      DestinationKit("storage"),
      DestinationKit("ota"),
    ),
  )

  fun scheduleNetworkKitCleanup() {
    cleanupNetworkKit(0)
  }

  fun installLifecycleRestore(application: Application) {
    if (lifecycleRestoreInstalled) return
    lifecycleRestoreInstalled = true
    application.registerActivityLifecycleCallbacks(
      object : Application.ActivityLifecycleCallbacks {
        override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) = Unit
        override fun onActivityStarted(activity: Activity) = Unit
        override fun onActivityResumed(activity: Activity) {
          if (inspectorVisible) return
          currentActivity = activity
          if (!launcherInitialized) {
            launcherInitialized = true
            DoKitManager.MAIN_ICON_HAS_SHOW = false
            DoKitManager.ALWAYS_SHOW_MAIN_ICON = false
          }
          showLauncherIfMissing(activity)
        }
        override fun onActivityPaused(activity: Activity) = Unit
        override fun onActivityStopped(activity: Activity) = Unit
        override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) = Unit
        override fun onActivityDestroyed(activity: Activity) {
          if (currentActivity === activity) currentActivity = null
        }
      },
    )
  }

  fun hideLauncherForInspector() {
    inspectorVisible = true
    DoKit.removeFloating(MobileDiagnosticsMainIconDoKitView::class.java)
  }

  fun restoreLauncherAfterInspector() {
    inspectorVisible = false
    currentActivity?.let { showLauncherIfMissing(it) }
  }

  private fun showLauncherIfMissing(activity: Activity) {
    if (DoKit.getDoKitView(activity, MobileDiagnosticsMainIconDoKitView::class.java) == null) {
      DoKit.launchFloating(MobileDiagnosticsMainIconDoKitView::class.java)
    }
  }

  /**
   * DoKit's stock main icon is a full-screen transparent system window in
   * some Android configurations. Keep the system-window mode (RN modals can
   * otherwise cover it) while constraining the touch target to the icon.
   */
  internal class MobileDiagnosticsMainIconDoKitView : AbsDoKitView() {
    override fun onCreate(context: Context) = Unit

    override fun onCreateView(context: Context, view: FrameLayout): View =
      LayoutInflater.from(context).inflate(
        com.didichuxing.doraemonkit.R.layout.dk_main_launch_icon,
        view,
        false,
      )

    override fun onViewCreated(view: FrameLayout) {
      view.setOnClickListener { DoKit.showToolPanel() }
    }

    override fun initDokitViewLayoutParams(params: DoKitViewLayoutParams) {
      val launcherSize = (
        LAUNCHER_SIZE_DP * DoKit.APPLICATION.resources.displayMetrics.density
      ).toInt()
      params.width = launcherSize
      params.height = launcherSize
      params.gravity = Gravity.TOP or Gravity.START
      params.x = com.didichuxing.doraemonkit.config.FloatIconConfig.getLastPosX()
      params.y = com.didichuxing.doraemonkit.config.FloatIconConfig.getLastPosY()
    }

    private companion object {
      const val LAUNCHER_SIZE_DP = 48
    }
  }

  private fun cleanupNetworkKit(attempt: Int) {
    var removed = false
    DoKitManager.GLOBAL_KITS.values.forEach { kits ->
      removed = kits.removeAll { it.kit?.innerKitId() == OFFICIAL_NETWORK_KIT } || removed
    }
    DoKitManager.GLOBAL_SYSTEM_KITS.values.forEach { kits ->
      removed = kits.removeAll { it.kit?.innerKitId() == OFFICIAL_NETWORK_KIT } || removed
    }
    if (!removed && attempt < CLEANUP_ATTEMPTS) {
      android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
        { cleanupNetworkKit(attempt + 1) },
        100L,
      )
    }
  }

  private class DestinationKit(
    private val destination: String,
  ) : AbstractKit() {
    override val name: Int
      get() = when (destination) {
        "network" -> R.string.mobile_diagnostics_network
        "ota" -> R.string.mobile_diagnostics_expo_update
        else -> R.string.mobile_diagnostics_local_state
      }

    override val icon: Int
      get() = when (destination) {
        "network" -> android.R.drawable.ic_menu_search
        "ota" -> R.drawable.mobile_diagnostics_expo_update
        else -> android.R.drawable.ic_menu_edit
      }

    override fun onAppInit(context: Context?) {
      if (destination == "network") scheduleNetworkKitCleanup()
    }

    override fun onClickWithReturn(activity: Activity): Boolean {
      if (destination == "network") cleanupNetworkKit(0)
      return MobileDiagnosticsLauncher.openAfterPanelDismiss(activity, destination)
    }
  }
}
