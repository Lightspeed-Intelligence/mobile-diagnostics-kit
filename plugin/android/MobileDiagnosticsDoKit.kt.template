internal object MobileDiagnosticsDoKit {
  private const val OPEN_EVENT = "mobile-diagnostics-kit.open"
  private const val OFFICIAL_NETWORK_KIT = "dokit_sdk_performance_ck_network"
  private const val CLEANUP_ATTEMPTS = 20
  private var lifecycleRestoreInstalled = false

  fun kits(): LinkedHashMap<String, List<AbstractKit>> = linkedMapOf(
    "Application Tools" to listOf(
      DestinationKit("network"),
      DestinationKit("storage"),
      DestinationKit("ota"),
    ),
  )

  fun scheduleNetworkKitCleanup() {
    cleanupNetworkKit(0)
  }

  fun installLifecycleRestore(application: Application) {
    if (lifecycleRestoreInstalled) return
    lifecycleRestoreInstalled = true
    application.registerActivityLifecycleCallbacks(object : Application.ActivityLifecycleCallbacks {
      override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) = Unit
      override fun onActivityStarted(activity: Activity) = Unit
      override fun onActivityResumed(activity: Activity) {
        DoKit.show()
      }
      override fun onActivityPaused(activity: Activity) = Unit
      override fun onActivityStopped(activity: Activity) = Unit
      override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) = Unit
      override fun onActivityDestroyed(activity: Activity) = Unit
    })
  }

  private fun cleanupNetworkKit(attempt: Int) {
    var removed = false
    DoKitManager.GLOBAL_KITS.values.forEach { kits ->
      if (kits.removeAll { item -> item.kit?.innerKitId() == OFFICIAL_NETWORK_KIT }) {
        removed = true
      }
    }
    DoKitManager.GLOBAL_SYSTEM_KITS.values.forEach { kits ->
      if (kits.removeAll { item -> item.kit?.innerKitId() == OFFICIAL_NETWORK_KIT }) {
        removed = true
      }
    }
    if (!removed && attempt < CLEANUP_ATTEMPTS) {
      android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
        { cleanupNetworkKit(attempt + 1) },
        100L,
      )
    }
  }

  private class DestinationKit(
    private val destination: String,
  ) : AbstractKit() {
    override val name: Int
      get() = when (destination) {
        "network" -> R.string.mobile_diagnostics_network
        "ota" -> R.string.mobile_diagnostics_expo_update
        else -> R.string.mobile_diagnostics_local_state
      }

    override val icon: Int
      get() = when (destination) {
        "network" -> android.R.drawable.ic_menu_search
        "ota" -> android.R.drawable.ic_popup_sync
        else -> android.R.drawable.ic_menu_edit
      }

    override fun onAppInit(context: Context?) {
      // The DoKit system kit is still useful as the capture engine, but its
      // old Activity must not remain visible beside our inspector.
      if (destination == "network") {
        scheduleNetworkKitCleanup()
      }
    }

    override fun onClickWithReturn(activity: Activity): Boolean {
      if (destination == "network") {
        cleanupNetworkKit(0)
        DoKit.hideToolPanel()
        startUniversalActivity(
          MobileDiagnosticsNetworkFragment::class.java,
          activity,
          null,
          true,
        )
        return true
      }

      val reactApplication = activity.application as? com.facebook.react.ReactApplication
      val reactContext = reactApplication?.reactHost?.currentReactContext
        ?: reactApplication?.reactNativeHost?.reactInstanceManager?.currentReactContext
      if (reactContext == null) {
        Toast.makeText(
          activity,
          R.string.mobile_diagnostics_runtime_unavailable,
          Toast.LENGTH_SHORT,
        ).show()
        return false
      }

      val payload = com.facebook.react.bridge.Arguments.createMap().apply {
        putString("destination", destination)
      }
      reactContext
        .getJSModule(com.facebook.react.modules.core.DeviceEventManagerModule.RCTDeviceEventEmitter::class.java)
        .emit(OPEN_EVENT, payload)
      DoKit.hideToolPanel()
      return true
    }
  }
}

private enum class MDKNetworkFilter(val label: String) {
  ALL("All"),
  FETCH("Fetch"),
  IMAGE("Image"),
  MEDIA("Media"),
  OTHER("Other"),
  ERRORS("Errors"),
}

private enum class MDKNetworkDetailTab(val label: String) {
  REQUEST("Request"),
  RESPONSE("Response"),
}

private const val NETWORK_PAGE_SIZE = 100
private const val NETWORK_REFRESH_INTERVAL_MS = 500L

internal class MobileDiagnosticsNetworkFragment : BaseFragment() {
  private val mainHandler = Handler(Looper.getMainLooper())
  private lateinit var root: LinearLayout
  private lateinit var content: LinearLayout
  private var query = ""
  private var filter = MDKNetworkFilter.ALL
  private var selected: NetworkRecord? = null
  private var detailTab = MDKNetworkDetailTab.REQUEST
  private var searchInput: EditText? = null
  private var requestCountLabel: TextView? = null
  private var errorCountLabel: TextView? = null
  private var receivedBytesLabel: TextView? = null
  private var showingLabel: TextView? = null
  private var visibleLimit = NETWORK_PAGE_SIZE
  private val listRefreshScheduled = AtomicBoolean(false)
  private val listRefreshRunnable = Runnable {
    listRefreshScheduled.set(false)
    if (isAdded && isResumed && selected == null) renderRequestContent()
  }

  private val networkListener = object : OnNetworkInfoUpdateListener {
    override fun onNetworkInfoUpdate(record: NetworkRecord?, isNew: Boolean) {
      if (listRefreshScheduled.compareAndSet(false, true)) {
        mainHandler.postDelayed(listRefreshRunnable, NETWORK_REFRESH_INTERVAL_MS)
      }
    }
  }

  override fun onRequestLayout(): Int = 0

  override fun onCreateView(
    inflater: LayoutInflater,
    container: ViewGroup?,
    savedInstanceState: Bundle?,
  ): View {
    root = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setBackgroundColor(backgroundColor())
    }
    ViewCompat.setOnApplyWindowInsetsListener(root) { view, insets ->
      val systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
      view.setPadding(systemBars.left, systemBars.top, systemBars.right, systemBars.bottom)
      insets
    }
    renderList()
    return root
  }

  override fun onResume() {
    super.onResume()
    NetworkManager.get().setOnNetworkInfoUpdateListener(networkListener)
    if (selected == null) renderRequestContent()
  }

  override fun onPause() {
    NetworkManager.get().setOnNetworkInfoUpdateListener(null)
    mainHandler.removeCallbacks(listRefreshRunnable)
    listRefreshScheduled.set(false)
    super.onPause()
  }

  override fun onDestroyView() {
    mainHandler.removeCallbacks(listRefreshRunnable)
    listRefreshScheduled.set(false)
    DoKit.show()
    super.onDestroyView()
  }

  override fun onBackPressed(): Boolean {
    if (selected != null) {
      selected = null
      renderList()
      return true
    }
    closeInspector()
    return true
  }

  private fun closeInspector() {
    DoKit.show()
    finish()
  }

  private fun renderList() {
    if (!::root.isInitialized) return
    selected = null
    detailTab = MDKNetworkDetailTab.REQUEST
    root.removeAllViews()
    root.addView(header("Network", false) { closeInspector() })

    val toolbar = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(16), dp(4), dp(16), dp(6))
    }
    toolbar.addView(summaryCard(), LinearLayout.LayoutParams(-1, -2).apply {
      bottomMargin = dp(10)
    })

    searchInput = EditText(requireContext()).apply {
      hint = "Search host, path, method, or status"
      inputType = InputType.TYPE_CLASS_TEXT
      setSingleLine(true)
      textSize = 14f
      setTextColor(textColor())
      setHintTextColor(mutedTextColor())
      setCompoundDrawablesWithIntrinsicBounds(android.R.drawable.ic_menu_search, 0, 0, 0)
      compoundDrawablePadding = dp(8)
      compoundDrawableTintList = ColorStateList.valueOf(mutedTextColor())
      setPadding(dp(12), 0, dp(14), 0)
      background = rounded(surfaceColor(), borderColor(), dp(12))
      imeOptions = android.view.inputmethod.EditorInfo.IME_ACTION_SEARCH
      setText(query)
      setSelection(text.length)
      addTextChangedListener(object : TextWatcher {
        override fun beforeTextChanged(value: CharSequence?, start: Int, count: Int, after: Int) = Unit
        override fun onTextChanged(value: CharSequence?, start: Int, before: Int, count: Int) = Unit
        override fun afterTextChanged(value: Editable?) {
          val next = value?.toString().orEmpty()
          if (next == query) return
          query = next
          visibleLimit = NETWORK_PAGE_SIZE
          renderRequestContent()
        }
      })
    }
    toolbar.addView(searchInput, LinearLayout.LayoutParams(-1, dp(48)))

    val filterScroll = HorizontalScrollView(requireContext()).apply {
      isHorizontalScrollBarEnabled = false
      overScrollMode = View.OVER_SCROLL_NEVER
    }
    val chips = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(3), dp(3), dp(3), dp(3))
      background = rounded(raisedColor(), raisedColor(), dp(10))
    }
    MDKNetworkFilter.values().forEach { option ->
      val chip = TextView(requireContext()).apply {
        text = option.label
        textSize = 12f
        gravity = Gravity.CENTER
        setTypeface(null, if (option == filter) Typeface.BOLD else Typeface.NORMAL)
        setPadding(dp(12), 0, dp(12), 0)
        setTextColor(if (option == filter) textColor() else secondaryTextColor())
        background = if (option == filter) {
          rounded(surfaceColor(), borderColor(), dp(8))
        } else {
          rounded(raisedColor(), raisedColor(), dp(8))
        }
        setOnClickListener {
          filter = option
          visibleLimit = NETWORK_PAGE_SIZE
          renderList()
        }
        contentDescription = "Filter ${option.label}"
      }
      chips.addView(chip, LinearLayout.LayoutParams(-2, dp(34)))
    }
    filterScroll.addView(chips)
    toolbar.addView(filterScroll, LinearLayout.LayoutParams(-1, dp(48)).apply {
      topMargin = dp(8)
    })

    showingLabel = text("", 11f, mutedTextColor(), monospace = true)
    toolbar.addView(showingLabel, LinearLayout.LayoutParams(-1, -2).apply {
      topMargin = dp(5)
    })

    content = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(16), dp(4), dp(16), dp(24))
    }
    root.addView(toolbar)

    val scroll = ScrollView(requireContext()).apply {
      isFillViewport = true
      addView(content)
    }
    root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))

    renderRequestContent()
  }

  private fun renderRequestContent() {
    if (!::content.isInitialized) return
    val records = records().asReversed()
    val visible = records.filter { record ->
      val matchesFilter = when (filter) {
        MDKNetworkFilter.ALL -> true
        MDKNetworkFilter.ERRORS -> isError(record)
        else -> resourceType(record) == filter
      }
      val needle = query.trim().lowercase(Locale.ROOT)
      matchesFilter && (needle.isEmpty() || searchableText(record).contains(needle))
    }
    val page = visible.take(visibleLimit)
    content.removeAllViews()
    updateSummary(records)
    showingLabel?.text = "Showing ${page.size} of ${visible.size} matching"

    if (visible.isEmpty()) {
      val emptyTitle = when {
        records.isEmpty() -> "No requests captured"
        query.isNotBlank() -> "No matching requests"
        filter == MDKNetworkFilter.ERRORS -> "No errors captured"
        else -> "No ${filter.label} requests"
      }
      content.addView(text(emptyTitle, 16f, secondaryTextColor(), true).apply {
        gravity = Gravity.CENTER
        setPadding(0, dp(52), 0, dp(6))
      })
      content.addView(text(
        if (records.isEmpty()) "Use the app, then pull back here to inspect requests."
        else "Try a different search or switch back to All.",
        13f,
        mutedTextColor(),
      ).apply { gravity = Gravity.CENTER })
    } else {
      page.forEach { record -> content.addView(requestCard(record)) }
      if (page.size < visible.size) {
        content.addView(text("Load older", 14f, accentColor(), true).apply {
          gravity = Gravity.CENTER
          isClickable = true
          isFocusable = true
          background = rounded(surfaceColor(), accentColor(), dp(10))
          setOnClickListener {
            visibleLimit += NETWORK_PAGE_SIZE
            renderRequestContent()
          }
          contentDescription = "Load older network requests"
          layoutParams = LinearLayout.LayoutParams(-1, dp(44)).apply {
            topMargin = dp(4)
          }
        })
      }
    }
  }

  private fun renderDetail(record: NetworkRecord) {
    selected = record
    root.removeAllViews()
    root.addView(header("Request details", true) {
      selected = null
      renderList()
    })
    val scroll = ScrollView(requireContext())
    val detail = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(16), dp(6), dp(16), dp(28))
    }
    detail.addView(detailSummaryCard(record), LinearLayout.LayoutParams(-1, -2).apply {
      bottomMargin = dp(12)
    })
    detail.addView(detailTabs(record), LinearLayout.LayoutParams(-1, dp(44)).apply {
      bottomMargin = dp(12)
    })

    if (detailTab == MDKNetworkDetailTab.REQUEST) {
      detail.addView(keyValueSection("General", listOf(
        "Request URL" to requestUrl(record),
        "Method" to requestMethod(record),
        "Resource" to resourceType(record).label,
        "Started" to requestStartTime(record),
        "Duration" to requestDuration(record),
      ), initiallyExpanded = true))
      detail.addView(keyValueSection(
        "Request Headers",
        headerRows(record.mRequest?.headers),
        initiallyExpanded = false,
      ))
      detail.addView(bodySection("Payload", record.mRequest?.postData))
    } else {
      detail.addView(keyValueSection("General", listOf(
        "Status" to responseStatus(record),
        "Content Type" to (record.mResponse?.mimeType?.takeIf { it.isNotBlank() } ?: "—"),
        "Resource" to resourceType(record).label,
        "Transferred" to "↑ ${formatBytes(record.requestLength)}  ·  ↓ ${formatBytes(record.responseLength)}",
        "Duration" to requestDuration(record),
      ), initiallyExpanded = true))
      detail.addView(keyValueSection(
        "Response Headers",
        headerRows(record.mResponse?.headers),
        initiallyExpanded = false,
      ))
      detail.addView(bodySection("Response Body", record.mResponseBody))
    }
    scroll.addView(detail)
    root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))
  }

  private fun header(title: String, detail: Boolean, onBack: () -> Unit): View {
    val bar = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(16), dp(8), dp(16), dp(4))
      setBackgroundColor(backgroundColor())
    }
    val back = iconButton(
      androidx.appcompat.R.drawable.abc_ic_ab_back_material,
      if (detail) "Back to network" else "Close network",
      onBack,
    )
    bar.addView(back, LinearLayout.LayoutParams(dp(44), dp(44)))

    val titleStack = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(12), 0, dp(8), 0)
    }
    if (!detail) {
      titleStack.addView(text("ON-DEVICE DIAGNOSTICS", 10f, accentColor(), true))
    }
    titleStack.addView(text(title, 21f, textColor(), true))
    bar.addView(titleStack, LinearLayout.LayoutParams(0, dp(52), 1f))

    if (!detail) {
      bar.addView(iconButton(
        android.R.drawable.ic_popup_sync,
        "Refresh requests",
      ) { renderRequestContent() }, LinearLayout.LayoutParams(dp(44), dp(44)))
    } else {
      bar.addView(View(requireContext()), LinearLayout.LayoutParams(dp(44), dp(44)))
    }
    return bar
  }

  private fun requestCard(record: NetworkRecord): View {
    val card = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(13), dp(13), dp(13), dp(13))
      background = rounded(surfaceColor(), borderColor(), dp(14))
      isClickable = true
      isFocusable = true
      setOnClickListener { renderDetail(record) }
      contentDescription = "${requestMethod(record)} ${requestPath(record)}, status ${responseStatus(record)}, ${requestHost(record)}"
    }
    val firstLine = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
    }
    val method = requestMethod(record)
    firstLine.addView(text(method, 11f, Color.WHITE, true, monospace = true).apply {
      gravity = Gravity.CENTER
      background = rounded(methodColor(method), methodColor(method), dp(6))
      setPadding(dp(8), 0, dp(8), 0)
      minWidth = dp(54)
    }, LinearLayout.LayoutParams(-2, dp(24)))
    firstLine.addView(text(responseStatus(record), 12f, statusColor(record), true, monospace = true).apply {
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(10), 0, 0, 0)
    }, LinearLayout.LayoutParams(-2, dp(24)))
    firstLine.addView(text(requestHost(record), 12f, mutedTextColor()).apply {
      gravity = Gravity.CENTER_VERTICAL or Gravity.END
      maxLines = 1
      ellipsize = android.text.TextUtils.TruncateAt.MIDDLE
      setPadding(dp(8), 0, 0, 0)
    }, LinearLayout.LayoutParams(0, dp(24), 1f))
    firstLine.addView(text("›", 20f, mutedTextColor()).apply {
      gravity = Gravity.CENTER
    }, LinearLayout.LayoutParams(dp(18), dp(24)))
    card.addView(firstLine)

    card.addView(text(requestPath(record), 14f, textColor(), true, monospace = true).apply {
      maxLines = 2
      ellipsize = android.text.TextUtils.TruncateAt.MIDDLE
      setPadding(0, dp(8), 0, dp(8))
    })
    card.addView(text(requestMetadata(record), 11f, secondaryTextColor(), monospace = true).apply {
      maxLines = 1
      ellipsize = android.text.TextUtils.TruncateAt.END
    })
    return card.apply {
      layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(10) }
    }
  }

  private fun summaryCard(): View {
    requestCountLabel = text("0", 16f, textColor(), true, monospace = true)
    errorCountLabel = text("0", 16f, textColor(), true, monospace = true)
    receivedBytesLabel = text("0 B", 16f, textColor(), true, monospace = true)

    val metrics = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(8), dp(10), dp(8), dp(10))
      background = rounded(surfaceColor(), borderColor(), dp(14))
    }
    metrics.addView(metric("Requests", requestCountLabel!!), LinearLayout.LayoutParams(0, dp(56), 1f))
    metrics.addView(metric("Errors", errorCountLabel!!), LinearLayout.LayoutParams(0, dp(56), 1f))
    metrics.addView(metric("Received", receivedBytesLabel!!), LinearLayout.LayoutParams(0, dp(56), 1f))

    val captureSwitch = Switch(requireContext()).apply {
      isChecked = NetworkManager.isActive()
      thumbTintList = captureThumbColors()
      trackTintList = captureTrackColors()
      contentDescription = "Capture network requests"
      setOnCheckedChangeListener { _, enabled ->
        if (enabled) NetworkManager.get().startMonitor() else NetworkManager.get().stopMonitor()
        renderRequestContent()
      }
    }
    val capture = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      gravity = Gravity.CENTER
      addView(captureSwitch, LinearLayout.LayoutParams(-2, dp(34)))
      addView(text("Capture", 10f, mutedTextColor()).apply {
        gravity = Gravity.CENTER
      }, LinearLayout.LayoutParams(-1, dp(18)))
    }
    metrics.addView(capture, LinearLayout.LayoutParams(0, dp(56), 1f))
    return metrics
  }

  private fun metric(title: String, value: TextView): View = LinearLayout(requireContext()).apply {
    orientation = LinearLayout.VERTICAL
    gravity = Gravity.CENTER
    value.gravity = Gravity.CENTER
    addView(value, LinearLayout.LayoutParams(-1, dp(30)))
    addView(text(title, 10f, mutedTextColor()).apply {
      gravity = Gravity.CENTER
    }, LinearLayout.LayoutParams(-1, dp(18)))
  }

  private fun updateSummary(records: List<NetworkRecord>) {
    requestCountLabel?.text = records.size.toString()
    val errors = records.count(::isError)
    errorCountLabel?.text = errors.toString()
    errorCountLabel?.setTextColor(if (errors > 0) statusErrorColor() else textColor())
    receivedBytesLabel?.text = formatBytes(records.sumOf { it.responseLength })
  }

  private fun detailSummaryCard(record: NetworkRecord): View {
    val card = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      background = rounded(surfaceColor(), borderColor(), dp(16))
      setPadding(dp(14), dp(14), dp(14), dp(14))
    }

    val top = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
    }
    val method = requestMethod(record)
    top.addView(text(method, 11f, Color.WHITE, true, monospace = true).apply {
      gravity = Gravity.CENTER
      minWidth = dp(54)
      background = rounded(methodColor(method), methodColor(method), dp(6))
    }, LinearLayout.LayoutParams(-2, dp(24)))
    top.addView(text(responseStatus(record), 13f, statusColor(record), true, monospace = true).apply {
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(9), 0, 0, 0)
    }, LinearLayout.LayoutParams(0, dp(44), 1f))
    val copyCurl = text("Copy cURL", 11f, secondaryTextColor(), true, monospace = true).apply {
      gravity = Gravity.CENTER
      background = rounded(raisedColor(), raisedColor(), dp(8))
      isClickable = true
      isFocusable = true
      contentDescription = "Copy request as cURL"
      setOnClickListener {
        copyToClipboard("cURL", curlCommand(record))
        Toast.makeText(requireContext(), "cURL copied", Toast.LENGTH_SHORT).show()
      }
    }
    top.addView(copyCurl, LinearLayout.LayoutParams(dp(104), dp(44)))
    card.addView(top)
    card.addView(text(requestHost(record), 12f, mutedTextColor()).apply {
      setPadding(0, dp(6), 0, 0)
    })
    card.addView(text(requestPath(record), 14f, textColor(), true, monospace = true).apply {
      setPadding(0, dp(6), 0, 0)
    })
    card.addView(text(requestMetadata(record), 11f, secondaryTextColor(), monospace = true).apply {
      setPadding(0, dp(8), 0, 0)
    })
    return card
  }

  private fun detailTabs(record: NetworkRecord): View {
    val tabs = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER
      setPadding(dp(3), dp(3), dp(3), dp(3))
      background = rounded(raisedColor(), raisedColor(), dp(10))
    }
    MDKNetworkDetailTab.values().forEach { tab ->
      tabs.addView(text(tab.label, 13f, if (tab == detailTab) textColor() else secondaryTextColor(), tab == detailTab).apply {
        gravity = Gravity.CENTER
        isClickable = true
        isFocusable = true
        background = if (tab == detailTab) rounded(surfaceColor(), borderColor(), dp(8))
        else rounded(raisedColor(), raisedColor(), dp(8))
        setOnClickListener {
          if (detailTab != tab) {
            detailTab = tab
            renderDetail(record)
          }
        }
        contentDescription = "Show ${tab.label.lowercase(Locale.ROOT)} details"
      }, LinearLayout.LayoutParams(0, -1, 1f))
    }
    return tabs
  }

  private fun keyValueSection(
    title: String,
    rows: List<Pair<String, String>>,
    initiallyExpanded: Boolean,
  ): View {
    val card = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      background = rounded(surfaceColor(), borderColor(), dp(14))
      setPadding(dp(14), dp(8), dp(14), dp(8))
    }
    val body = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      visibility = if (initiallyExpanded) View.VISIBLE else View.GONE
    }
    val chevron = text(if (initiallyExpanded) "⌄" else "›", 18f, mutedTextColor()).apply {
      gravity = Gravity.CENTER
    }
    val heading = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      isClickable = true
      isFocusable = true
      contentDescription = title
      addView(LinearLayout(requireContext()).apply {
        orientation = LinearLayout.VERTICAL
        gravity = Gravity.CENTER_VERTICAL
        addView(text(title, 15f, textColor(), true))
        addView(text(
          if (rows.size == 1) "1 field" else "${rows.size} fields",
          10f,
          mutedTextColor(),
        ))
      }, LinearLayout.LayoutParams(0, dp(48), 1f))
      if (rows.isNotEmpty()) {
        addView(iconButton(androidx.appcompat.R.drawable.abc_ic_menu_copy_mtrl_am_alpha, "Copy ${title.lowercase(Locale.ROOT)}") {
          copyToClipboard(title, rows.joinToString("\n") { "${it.first}: ${it.second}" })
        }, LinearLayout.LayoutParams(dp(44), dp(44)))
      }
      addView(chevron, LinearLayout.LayoutParams(dp(24), dp(44)))
      setOnClickListener {
        val expanded = body.visibility != View.VISIBLE
        body.visibility = if (expanded) View.VISIBLE else View.GONE
        chevron.text = if (expanded) "⌄" else "›"
      }
    }
    card.addView(heading)
    if (rows.isEmpty()) {
      body.addView(text("No fields", 13f, mutedTextColor()).apply {
        setPadding(0, dp(10), 0, dp(10))
      })
    } else {
      rows.forEachIndexed { index, (label, value) ->
        if (index > 0) body.addView(divider())
        val row = LinearLayout(requireContext()).apply {
          orientation = LinearLayout.HORIZONTAL
          gravity = Gravity.TOP
          setPadding(0, dp(11), 0, dp(11))
        }
        row.addView(text(label, 12f, codeKeyColor()).apply {
          setPadding(0, 0, dp(10), 0)
        }, LinearLayout.LayoutParams(dp(104), -2))
        row.addView(text(value, 12f, secondaryTextColor(), monospace = true).apply {
          setTextIsSelectable(true)
        }, LinearLayout.LayoutParams(0, -2, 1f))
        body.addView(row)
      }
    }
    card.addView(body)
    return card.apply {
      layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(12) }
    }
  }

  private fun bodySection(title: String, rawBody: String?): View {
    val original = rawBody.orEmpty()
    val presented = prettyBody(original)
    val card = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.VERTICAL
      background = rounded(surfaceColor(), borderColor(), dp(14))
      setPadding(dp(14), dp(10), dp(14), dp(14))
    }
    val heading = LinearLayout(requireContext()).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
    }
    heading.addView(text(title, 15f, textColor(), true), LinearLayout.LayoutParams(0, dp(44), 1f))
    val format = if (isJson(original)) "JSON" else "TEXT"
    heading.addView(text(format, 10f, mutedTextColor(), true, monospace = true).apply {
      gravity = Gravity.CENTER
      background = rounded(raisedColor(), raisedColor(), dp(5))
    }, LinearLayout.LayoutParams(dp(48), dp(22)))
    if (original.isNotEmpty()) {
      heading.addView(iconButton(androidx.appcompat.R.drawable.abc_ic_menu_copy_mtrl_am_alpha, "Copy ${title.lowercase(Locale.ROOT)}") {
        copyToClipboard(title, original)
      }, LinearLayout.LayoutParams(dp(44), dp(44)))
    }
    card.addView(heading)
    card.addView(text(presented, 12f, secondaryTextColor(), monospace = true).apply {
      setTextIsSelectable(true)
      setPadding(dp(10), dp(12), dp(10), dp(12))
      minHeight = dp(72)
      background = rounded(raisedColor(), raisedColor(), dp(10))
    })
    return card.apply {
      layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(12) }
    }
  }

  private fun records(): List<NetworkRecord> {
    val all = NetworkManager.get().records
    return synchronized(all) { all.toList() }
  }

  private fun requestUrl(record: NetworkRecord): String = record.mRequest?.url ?: "Unknown URL"

  private fun requestMethod(record: NetworkRecord): String =
    (record.mRequest?.method ?: "HTTP").uppercase(Locale.ROOT)

  private fun requestHost(record: NetworkRecord): String {
    val uri = Uri.parse(requestUrl(record))
    return uri.host?.takeIf { it.isNotBlank() } ?: "Unknown host"
  }

  private fun requestPath(record: NetworkRecord): String {
    val uri = Uri.parse(requestUrl(record))
    val path = uri.encodedPath?.takeIf { it.isNotBlank() } ?: "/"
    return uri.encodedQuery?.takeIf { it.isNotBlank() }?.let { "$path?$it" } ?: path
  }

  private fun responseStatus(record: NetworkRecord): String {
    val status = record.mResponse?.status ?: 0
    return if (status > 0) status.toString() else "Pending"
  }

  private fun searchableText(record: NetworkRecord): String = listOf(
    requestUrl(record),
    requestHost(record),
    requestPath(record),
    requestMethod(record),
    responseStatus(record),
    record.mResponse?.mimeType.orEmpty(),
    resourceType(record).label,
  ).joinToString(" ").lowercase(Locale.ROOT)

  private fun isError(record: NetworkRecord): Boolean {
    val status = record.mResponse?.status ?: 0
    return status <= 0 || status >= 400
  }

  private fun resourceType(record: NetworkRecord): MDKNetworkFilter {
    val mime = record.mResponse?.mimeType.orEmpty().lowercase(Locale.ROOT)
    val url = requestUrl(record).lowercase(Locale.ROOT)
    if (mime.startsWith("image/") || url.substringBefore('?').matches(Regex(".*\\.(png|jpe?g|gif|webp|svg)$"))) {
      return MDKNetworkFilter.IMAGE
    }
    if (mime.startsWith("video/") || mime.startsWith("audio/") || url.substringBefore('?').matches(Regex(".*\\.(mp4|mov|mp3|m4a|wav)$"))) {
      return MDKNetworkFilter.MEDIA
    }
    if (mime.contains("json") || mime.contains("text") || mime.contains("xml") ||
      (record.mRequest?.method?.uppercase(Locale.ROOT) in setOf("GET", "POST", "PUT", "PATCH", "DELETE"))) {
      return MDKNetworkFilter.FETCH
    }
    return MDKNetworkFilter.OTHER
  }

  private fun requestMetadata(record: NetworkRecord): String =
    "${requestDuration(record)}  ·  ↑ ${formatBytes(record.requestLength)}  ·  ↓ ${formatBytes(record.responseLength)}  ·  ${requestStartTime(record)}"

  private fun requestDuration(record: NetworkRecord): String {
    val duration = record.endTime - record.startTime
    if (duration <= 0L) return "—"
    if (duration < 1000L) return "$duration ms"
    return String.format(Locale.US, "%.2f s", duration / 1000.0)
  }

  private fun requestStartTime(record: NetworkRecord): String {
    if (record.startTime <= 0L) return "—"
    return SimpleDateFormat("HH:mm:ss", Locale.US).format(Date(record.startTime))
  }

  private fun formatBytes(bytes: Long): String = when {
    bytes >= 1024L * 1024L -> String.format(Locale.US, "%.1f MB", bytes / (1024.0 * 1024.0))
    bytes >= 1024L -> String.format(Locale.US, "%.1f KB", bytes / 1024.0)
    else -> "${bytes.coerceAtLeast(0L)} B"
  }

  private fun headerRows(headers: String?): List<Pair<String, String>> {
    val source = headers?.trim().orEmpty()
    if (source.isEmpty()) return emptyList()
    val normalized = source.removePrefix("{").removeSuffix("}")
    val lines = normalized.split(Regex("\\r?\\n|, (?=[^,]+[:=])"))
    return lines.mapNotNull { line ->
      val separator = listOf(line.indexOf(':'), line.indexOf('='))
        .filter { it > 0 }
        .minOrNull()
        ?: return@mapNotNull null
      line.substring(0, separator).trim() to line.substring(separator + 1).trim()
    }.ifEmpty { listOf("Headers" to source) }
  }

  private fun prettyBody(body: String): String {
    if (body.isBlank()) return "No body"
    val pretty = try {
      when {
        body.trimStart().startsWith("{") -> JSONObject(body).toString(2)
        body.trimStart().startsWith("[") -> JSONArray(body).toString(2)
        else -> body
      }
    } catch (_: Exception) {
      body
    }
    val limit = 120_000
    return if (pretty.length > limit) {
      pretty.take(limit) + "\n\n… truncated for on-device display"
    } else {
      pretty
    }
  }

  private fun isJson(body: String): Boolean {
    if (body.isBlank()) return false
    return try {
      when {
        body.trimStart().startsWith("{") -> JSONObject(body)
        body.trimStart().startsWith("[") -> JSONArray(body)
        else -> return false
      }
      true
    } catch (_: Exception) {
      false
    }
  }

  private fun curlCommand(record: NetworkRecord): String {
    val request = record.mRequest
    val method = (request?.method ?: "GET").uppercase(Locale.ROOT)
    return buildString {
      append("curl --location --request ").append(shellQuote(method)).append(" ")
      append(shellQuote(request?.url ?: ""))
      request?.headers.orEmpty().split(Regex("\\r?\\n")).forEach { line ->
        val separator = line.indexOf(':')
        if (separator > 0) {
          append(" \\\\n  -H ").append(shellQuote(line.trim()))
        }
      }
      if (!request?.postData.isNullOrEmpty()) {
        append(" \\\\n  --data-raw ").append(shellQuote(request?.postData.orEmpty()))
      }
    }
  }

  private fun shellQuote(value: String): String = "'${value.replace("'", "'\\\\''")}'"

  private fun copyToClipboard(label: String, value: String) {
    val clipboard = requireContext().getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
    clipboard.setPrimaryClip(ClipData.newPlainText(label, value))
  }

  private fun iconButton(
    icon: Int,
    description: String,
    onClick: () -> Unit,
  ): ImageButton = ImageButton(requireContext()).apply {
    setImageResource(icon)
    setColorFilter(secondaryTextColor())
    setPadding(dp(12), dp(12), dp(12), dp(12))
    background = rounded(raisedColor(), raisedColor(), dp(22))
    contentDescription = description
    isFocusable = true
    setOnClickListener { onClick() }
  }

  private fun divider(): View = View(requireContext()).apply {
    setBackgroundColor(borderColor())
    layoutParams = LinearLayout.LayoutParams(-1, dp(1))
  }

  private fun methodColor(method: String): Int = when (method.uppercase(Locale.ROOT)) {
    "GET" -> if (isDarkTheme()) Color.rgb(59, 130, 246) else Color.rgb(37, 99, 235)
    "POST" -> if (isDarkTheme()) Color.rgb(167, 139, 250) else Color.rgb(124, 58, 237)
    "PUT", "PATCH" -> if (isDarkTheme()) Color.rgb(245, 158, 11) else Color.rgb(180, 83, 9)
    "DELETE" -> if (isDarkTheme()) Color.rgb(248, 113, 113) else Color.rgb(185, 28, 28)
    else -> if (isDarkTheme()) Color.rgb(100, 116, 139) else Color.rgb(71, 85, 105)
  }

  private fun statusColor(record: NetworkRecord): Int {
    val status = record.mResponse?.status ?: 0
    return when {
      status in 200..299 -> accentColor()
      status in 300..399 -> if (isDarkTheme()) Color.rgb(56, 189, 248) else Color.rgb(3, 105, 161)
      status in 400..499 -> if (isDarkTheme()) Color.rgb(245, 158, 11) else Color.rgb(180, 83, 9)
      status >= 500 || status <= 0 -> statusErrorColor()
      else -> mutedTextColor()
    }
  }

  private fun isDarkTheme(): Boolean =
    resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK == Configuration.UI_MODE_NIGHT_YES

  private fun backgroundColor(): Int =
    if (isDarkTheme()) Color.rgb(15, 23, 42) else Color.rgb(248, 250, 252)

  private fun surfaceColor(): Int =
    if (isDarkTheme()) Color.rgb(30, 41, 59) else Color.WHITE

  private fun raisedColor(): Int =
    if (isDarkTheme()) Color.rgb(38, 52, 73) else Color.rgb(241, 245, 249)

  private fun borderColor(): Int =
    if (isDarkTheme()) Color.rgb(51, 65, 85) else Color.rgb(203, 213, 225)

  private fun textColor(): Int =
    if (isDarkTheme()) Color.rgb(248, 250, 252) else Color.rgb(15, 23, 42)

  private fun secondaryTextColor(): Int =
    if (isDarkTheme()) Color.rgb(203, 213, 225) else Color.rgb(71, 85, 105)

  private fun mutedTextColor(): Int =
    if (isDarkTheme()) Color.rgb(148, 163, 184) else Color.rgb(100, 116, 139)

  private fun accentColor(): Int =
    if (isDarkTheme()) Color.rgb(34, 197, 94) else Color.rgb(21, 128, 61)

  private fun codeKeyColor(): Int =
    if (isDarkTheme()) Color.rgb(96, 165, 250) else Color.rgb(29, 78, 216)

  private fun statusErrorColor(): Int =
    if (isDarkTheme()) Color.rgb(248, 113, 113) else Color.rgb(185, 28, 28)

  private fun captureThumbColors(): ColorStateList = ColorStateList(
    arrayOf(
      intArrayOf(android.R.attr.state_checked),
      intArrayOf(),
    ),
    intArrayOf(Color.WHITE, if (isDarkTheme()) Color.rgb(203, 213, 225) else Color.WHITE),
  )

  private fun captureTrackColors(): ColorStateList = ColorStateList(
    arrayOf(
      intArrayOf(android.R.attr.state_checked),
      intArrayOf(),
    ),
    intArrayOf(accentColor(), borderColor()),
  )

  private fun rounded(fill: Int, stroke: Int, radius: Int): GradientDrawable = GradientDrawable().apply {
    setColor(fill)
    setStroke(dp(1), stroke)
    cornerRadius = radius.toFloat()
  }

  private fun text(
    value: String,
    size: Float,
    color: Int,
    bold: Boolean = false,
    monospace: Boolean = false,
  ): TextView = TextView(requireContext()).apply {
    text = value
    textSize = size
    setTextColor(color)
    if (monospace) {
      setTypeface(Typeface.MONOSPACE, if (bold) Typeface.BOLD else Typeface.NORMAL)
    } else if (bold) {
      setTypeface(null, Typeface.BOLD)
    }
  }

  private fun dp(value: Int): Int = (value * resources.displayMetrics.density).toInt()
}
